# ==============================================================================
# PhoneMail Environment Configuration Template
# ==============================================================================

# Application environment
NODE_ENV=development
PORT=3000

# Database (PostgreSQL 16)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=phonemail
POSTGRES_USER=phonemail
POSTGRES_PASSWORD=phonemail_dev
PG_MAX_POOL=20
DATABASE_URL=postgresql://phonemail:phonemail_dev@postgres:5432/phonemail

# Mailpit (Local SMTP & Web UI)
SMTP_HOST=mailpit
SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# Frontend
FRONTEND_PORT=3000
